{
  "folders": [
    {
      "path": "."
    }
  ],
  "settings": {
    "python.defaultInterpreterPath": "${workspaceFolder}/venv/bin/python",
    "python.linting.enabled": true,
    "python.linting.pylintEnabled": false,
    "python.linting.flake8Enabled": true,
    "python.formatting.provider": "black",
    "python.testing.pytestEnabled": true,
    "python.testing.unittestEnabled": false,
    "files.exclude": {
      "**/__pycache__": true,
      "**/*.pyc": true,
      "**/.pytest_cache": true,
      "**/venv": true,
      "**/.venv": true
    },
    "python.analysis.extraPaths": [
      "${workspaceFolder}"
    ],
    "files.associations": {
      "*.urdf": "xml",
      "*.yaml": "yaml"
    },
    "editor.formatOnSave": true,
    "editor.rulers": [88],
    "python.analysis.typeCheckingMode": "basic"
  },
  "extensions": {
    "recommendations": [
      "ms-python.python",
      "ms-python.vscode-pylance",
      "ms-toolsai.jupyter",
      "redhat.vscode-yaml",
      "donjayamanne.githistory"
    ]
  },
  "launch": {
    "version": "0.2.0",
    "configurations": [
      {
        "name": "Train PPO",
        "type": "python",
        "request": "launch",
        "program": "${workspaceFolder}/self_balancing_robot/scripts/train_ppo.py",
        "args": ["--timesteps", "100000"],
        "console": "integratedTerminal",
        "cwd": "${workspaceFolder}/self_balancing_robot"
      },
      {
        "name": "Test Model",
        "type": "python",
        "request": "launch",
        "program": "${workspaceFolder}/self_balancing_robot/scripts/test_model.py",
        "args": ["--random", "--episodes", "3"],
        "console": "integratedTerminal",
        "cwd": "${workspaceFolder}/self_balancing_robot"
      },
      {
        "name": "Raspberry Pi Inference (Simulation)",
        "type": "python",
        "request": "launch",
        "program": "${workspaceFolder}/self_balancing_robot/scripts/raspberry_pi_inference.py",
        "args": ["saved_models/ppo_final.zip", "--duration", "30"],
        "console": "integratedTerminal",
        "cwd": "${workspaceFolder}/self_balancing_robot"
      }
    ]
  }
}
